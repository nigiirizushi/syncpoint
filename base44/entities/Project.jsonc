{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "color": {
      "type": "string",
      "description": "Hex color for visual identification"
    },
    "description": {
      "type": "string",
      "description": "Optional short description"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether the project is archived"
    }
  },
  "required": [
    "name",
    "color"
  ]
}